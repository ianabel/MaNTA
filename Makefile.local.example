
# A simple makefile for compiling on linux
# if you are following the guide in the README

# Uncomment to use clang instead of g++
# CXX = clang++

# Uncomment for debug information
# DEBUG = on


#CXXFLAGS = -DFPEXCEPT #-DSUNDIALS_DEBUG

# Points to an installation of SUNDIALS, v7.1.0 or above
SUNDIALS_DIR= ../sundials/install

# Where Eigen's own header directory lives -- the parent of Eigen/, not the
# directory holding Eigen/ itself if that is already on the compiler's default
# search path. Distributions put it in a subdirectory, hence eigen3 below.
EIGEN_DIR = /usr/include/eigen3

# netCDF needs nothing here for a package-manager install: apt's libnetcdf-dev and
# libnetcdf-c++4-dev land in /usr, which the compiler already searches, and
# Makefile.config asks pkg-config for the rest. Set these only for an install the
# compiler would not find on its own -- a brew/conda MacOS install, or an HPC
# module that does not export NETCDF_DIR itself.
# NETCDF_DIR = /usr/local/Cellar/netcdf/4.8.0_2
# NETCDF_CXX_DIR = /Users/<username>/miniconda3

