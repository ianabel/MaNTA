# Generated at configure time, executed at install time.
#
# manta.pc has to record the prefix the files actually went to, and that is not
# known until `cmake --install` runs: --prefix overrides CMAKE_INSTALL_PREFIX
# after the fact, and DESTDIR shifts everything again for a packaging build. A
# plain configure_file() at configure time bakes in whatever the prefix was when
# cmake last ran, so `cmake --install build --prefix /somewhere` produced a
# perfectly valid .pc pointing at /usr/local -- and the first symptom is a plugin
# that compiles against the wrong headers, or does not compile at all.
#
# @ONLY above leaves ${CMAKE_INSTALL_PREFIX} alone precisely so it can be
# resolved here instead.

set(PROJECT_DESCRIPTION "@PROJECT_DESCRIPTION@")
set(PROJECT_VERSION "@PROJECT_VERSION@")
set(CMAKE_INSTALL_INCLUDEDIR "@CMAKE_INSTALL_INCLUDEDIR@")
set(CMAKE_INSTALL_LIBDIR "@CMAKE_INSTALL_LIBDIR@")
set(MANTA_PC_STD "@MANTA_PC_STD@")
set(MANTA_PC_MARCH "@MANTA_PC_MARCH@")

# The dependency include directories (see CMakeLists.txt), as -isystem flags --
# SYSTEM, as the core includes them, so a plugin built with -Werror is not held
# to the warnings in Eigen's headers. Two kinds are dropped:
#
#   * the compiler's own search directories. Handing one to -isystem is not a
#     no-op: it moves the directory ahead of the libstdc++ headers, and
#     <cstdlib>'s #include_next <stdlib.h> then fails in every translation unit
#     (CLAUDE.md has the trap). CMake filters them from its own flags; this file
#     is not CMake's, so it does it itself.
#   * the vendored directories under the source tree, which an installed .pc
#     must not point into. toml11 is installed instead; autodiff is not needed.
file(READ "@PROJECT_BINARY_DIR@/manta-pc-includes.txt" _dirs)
set(_implicit "@CMAKE_CXX_IMPLICIT_INCLUDE_DIRECTORIES@")
set(_source_dir "@PROJECT_SOURCE_DIR@")
set(MANTA_PC_DEPENDENCY_CFLAGS "")
foreach(_d IN LISTS _dirs)
  if(_d STREQUAL "")
    continue()
  endif()
  cmake_path(NORMAL_PATH _d)
  string(REGEX REPLACE "/$" "" _d "${_d}")
  set(_skip FALSE)
  foreach(_i IN LISTS _implicit)
    cmake_path(NORMAL_PATH _i)
    string(REGEX REPLACE "/$" "" _i "${_i}")
    if(_d STREQUAL _i)
      set(_skip TRUE)
    endif()
  endforeach()
  cmake_path(IS_PREFIX _source_dir "${_d}" NORMALIZE _inside)
  if(NOT _skip AND NOT _inside AND NOT " ${MANTA_PC_DEPENDENCY_CFLAGS} " MATCHES " -isystem${_d} ")
    string(APPEND MANTA_PC_DEPENDENCY_CFLAGS " -isystem${_d}")
  endif()
endforeach()
string(STRIP "${MANTA_PC_DEPENDENCY_CFLAGS}" MANTA_PC_DEPENDENCY_CFLAGS)

# DESTDIR is a staging directory, not part of the recorded prefix: the .pc must
# say where the files will BE, while being written where they are staged.
set(_pc "${CMAKE_INSTALL_PREFIX}/${CMAKE_INSTALL_LIBDIR}/pkgconfig/manta.pc")
set(_dest "$ENV{DESTDIR}${_pc}")
configure_file("@PROJECT_SOURCE_DIR@/cmake/manta.pc.in" "${_dest}" @ONLY)
message(STATUS "Installing: ${_dest}")

# A file written by an install script is NOT recorded in install_manifest.txt
# unless the script says so, and the `uninstall` target reads nothing else -- so
# without this line manta.pc survives an uninstall, pointing at a prefix whose
# headers and library have gone. Appending to CMAKE_INSTALL_MANIFEST_FILES is the
# documented way for a script to register what it wrote; the recorded path
# excludes DESTDIR, as every other entry does.
list(APPEND CMAKE_INSTALL_MANIFEST_FILES "${_pc}")
