#!/bin/sh
#
# Build a minimal SUNDIALS into ./sundials/install for MaNTA.
#
# MaNTA needs v7.1.0 or later: it links sundials_core and uses SUNContext,
# neither of which exists before v7. This script used to fetch 5.7.0, which
# cannot build MaNTA at all.
#
# Override with e.g.  SUNDIALS_VERSION=7.4.0 ./build_sundials

set -e

SUNDIALS_VERSION=${SUNDIALS_VERSION:-7.5.0}
SUNDIALS_ROOT=$(realpath "${SUNDIALS_ROOT:-./sundials}")
SUNDIALS_URL="https://github.com/LLNL/sundials/releases/download/v${SUNDIALS_VERSION}/sundials-${SUNDIALS_VERSION}.tar.gz"

mkdir -p "$SUNDIALS_ROOT"
cd "$SUNDIALS_ROOT"

if [ ! -f "sundials-${SUNDIALS_VERSION}.tar.gz" ]; then
	wget -q "$SUNDIALS_URL"
fi

rm -rf "sundials-${SUNDIALS_VERSION}" build
tar xzf "sundials-${SUNDIALS_VERSION}.tar.gz"
mkdir -p build
cd build

# MaNTA uses IDA, KINSOL and the serial N_Vector; the rest is dead weight.
#
# KINSOL is what SteadyStateSolver drives for the PseudoTransient and Newton
# paths, so it has to be ON. The list below must stay in step with
# SUN_LINK_FLAGS in Makefile.config: a library MaNTA links and this script
# switches off is not a link error here but a missing header three files into
# the build, and only for someone whose SUNDIALS came from this script. Anyone
# who followed README.md's manual instructions instead has every solver, that
# being the SUNDIALS default, and so cannot reproduce it.
cmake "../sundials-${SUNDIALS_VERSION}/" \
	-DCMAKE_INSTALL_PREFIX="$SUNDIALS_ROOT/install" \
	-DCMAKE_BUILD_TYPE=Release \
	-DBUILD_SHARED_LIBS=ON \
	-DBUILD_STATIC_LIBS=OFF \
	-DEXAMPLES_INSTALL=OFF \
	-DEXAMPLES_ENABLE_C=OFF \
	-DBUILD_ARKODE=OFF \
	-DBUILD_CVODE=OFF \
	-DBUILD_CVODES=OFF \
	-DBUILD_IDAS=OFF \
	-DBUILD_KINSOL=ON

make -j"$(nproc)" install

cat <<EOF

SUNDIALS ${SUNDIALS_VERSION} installed. To build MaNTA, put

    SUNDIALS_DIR=$SUNDIALS_ROOT/install

in Makefile.local

EOF
