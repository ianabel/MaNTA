include Makefile.local

CXX ?= g++

STD=c++23

# Which compiler family we are on. A handful of flags below are gcc-only, and
# clang rejects one of them outright. Expanded once with := because it shells
# out; a recursive = would re-run `$(CXX) --version` on every reference.
#
# The project builds clean with g++-14, clang++-19 and clang++-21. Set CXX on the
# make command line to pick one -- Makefile.local assigns it, and a command-line
# assignment overrides that.
COMPILER_ID := $(if $(findstring clang,$(shell $(CXX) --version 2>/dev/null)),clang,gcc)

# The directories the compiler already searches for headers, so that we never
# hand it one of them ourselves.
#
# Passing a default system directory with -isystem is NOT a no-op. gcc and clang
# both de-duplicate it: the directory is dropped from its proper place at the END
# of the system chain and searched where the -isystem appeared, i.e. ahead of the
# libstdc++ headers. <cstdlib> then does `#include_next <stdlib.h>`, which only
# considers directories AFTER the one holding it, so stdlib.h becomes unreachable
# and every translation unit dies with
#
#   /usr/include/c++/16/cstdlib:83:15: fatal error: stdlib.h: No such file or directory
#      83 | #include_next <stdlib.h>
#
# NETCDF_DIR=/usr does exactly that, and so does EIGEN_DIR=/usr/include -- the
# first is what README step 4 used to ask for outright on a package-manager
# install, the second what Makefile.local.example's Eigen comment invited.
#
# -I would be safe
# (gcc documents that an -I naming a standard system directory "is ignored. The
# directory is still searched but as a system directory at its normal position"),
# but third-party headers need -isystem to stay clear of -Werror -- Eigen's own
# headers trip -Wunused-but-set-variable under clang. So filter, don't downgrade.
#
# Matched on "search starts here" rather than the full "#include <...>" banner
# because an unescaped # would start a make comment even inside $(shell).
# An empty result (probe failed) means nothing is filtered, which is the old
# behaviour rather than a new failure.
CXX_SYSTEM_INCLUDES := $(realpath $(shell $(CXX) -xc++ -E -v /dev/null 2>&1 | \
    sed -n '/search starts here:/,/^End of search list\./p' | \
    sed -e '1d' -e '$$d' -e 's/^ *//' -e 's/ (framework directory)$$//'))

# -isystem DIR, unless the compiler already searches DIR. Emits the path as
# given, so a relative one still works, but compares canonically: gcc reports its
# C++ directories as /usr/include/c++/16 while clang reports the same ones as
# /usr/lib/gcc/x86_64-linux-gnu/16/../../../../include/c++/16, so both sides of
# the filter have to be normalised. An empty DIR emits nothing rather than a bare
# -isystem that would swallow the next flag.
#
# This cannot be replaced by a "does the directory contain the header we want"
# test: /usr/include really does hold netcdf.h, so such a test would keep the
# flag and still break the build.
sysinclude = $(if $(strip $(1)),$(if $(filter $(realpath $(1)),$(CXX_SYSTEM_INCLUDES)),,-isystem $(1)))

# lib or lib64 under prefix $(1), whichever actually holds library $(2).
#
# Testing for the library rather than for "is this a system directory" gets three
# things at once. A prefix whose libraries are in lib64 now works, where netCDF
# only ever tried lib. /usr yields nothing, correctly: on a multiarch Debian the
# netCDF libraries are in /usr/lib/x86_64-linux-gnu, which the loader already
# searches, so NETCDF_DIR=/usr used to produce a -L that found nothing plus a
# /usr/lib rpath baked into every binary and into libmanta.so. And SUNDIALS_DIR's
# /usr/local default keeps its -L and rpath, because /usr/local/lib does hold
# libsundials_* -- a redundant rpath is harmless, while dropping a needed one is
# not, and which directories the loader searches is distro-dependent.
#
# There is deliberately no compiler probe here: clang rejects -print-multiarch as
# an unsupported option, and -dumpmachine gives x86_64-pc-linux-gnu rather than
# the multiarch triple, so there is no portable way to ask for the real libdir.
libdir_for = $(firstword $(foreach d,lib lib64,$(if $(wildcard $(1)/$(d)/$(2)*),$(realpath $(1)/$(d)))))

# -L and a matching rpath for DIR, or nothing at all if DIR is empty.
#
# $(comma) is not decoration. The comma in a literal -Wl,-rpath sits inside the
# $(if ...) call, where make reads it as the separator before the else-branch: the
# body then means "then: -L$(1) -Wl" and "else: -rpath $(1)", so an empty DIR
# emitted a bare -rpath and a real one silently lost its rpath.
comma := ,
syslibdir = $(if $(strip $(1)),-L$(1) -Wl$(comma)-rpath $(1))

ifdef OMP
CXXFLAGS += -fopenmp
else
CXXFLAGS += -Wno-unknown-pragmas
endif

# Emit a .d file per object listing every header it includes, so touching a
# header rebuilds exactly what depends on it. The hand-maintained $(HEADERS)
# list this replaces was missing Types.hpp, DGApprox.hpp, NetCDFIO.hpp and all
# of the Py*.hpp headers, so edits to those silently left stale objects (and a
# stale unit-test binary that still passed).
CXXFLAGS += -MMD -MP

ifdef COVERAGE
# Coverage needs -O0 and no LTO: optimisation and -flto destroy the mapping from
# machine code back to source lines, so gcov reports become meaningless.
CXXFLAGS += -fPIC -g -O0 --coverage -fno-inline --std=$(STD) -Wall -Wno-unused-variable -pedantic
# gcc-only. -fprofile-abs-path keeps .gcno references absolute so gcovr can
# resolve sources when make recurses into Tests/UnitTests; clang rejects it as an
# unknown argument. The two inline-tuning flags clang accepts but ignores, with a
# -Wignored-optimization-argument warning apiece.
ifeq ($(COMPILER_ID),gcc)
CXXFLAGS += -fprofile-abs-path -fno-inline-small-functions -fno-default-inline
endif
LDFLAGS  += --coverage
else ifdef DEBUG
CXXFLAGS += -fPIC -DDEBUG -DPHYSICS_DEBUG -g -O0 --std=$(STD) -Wall -Werror -Wno-error=unused-variable -pedantic
else
CXXFLAGS += -fPIC -O3 -flto=auto -march=native --std=$(STD) -Wall -Wno-unused-variable -Werror -pedantic
endif

# gcov must match the compiler that produced the .gcno files. The subst turns
# g++-14 into gcov-14; clang emits gcov-format data too, but it has to be read
# with `llvm-cov gcov` rather than gcov itself.
#
# Derived outside the COVERAGE branch above, deliberately. The top-level
# `coverage` target runs gcovr *itself* and only recurses with COVERAGE=on, so
# the make that expands $(GCOV) is the one where COVERAGE is undefined. Deriving
# it inside that branch left the parent with a bare `gcov`, which is gcov-14 on a
# Debian box whose default compiler is gcc-14 and gcov-13 on ubuntu-24.04, whose
# image ships gcc 12/13/14 with 13 as the default while the workflow builds with
# g++-14. gcov then exits 3 with
# `AdjointVectors.gcno:version 'B42*', prefer 'B33*'`, gcovr promotes that to a
# hard error, and `make coverage` failed on CI (exit 64) while passing locally.
ifeq ($(COMPILER_ID),gcc)
# With no "g++" in CXX there is nothing to substitute -- fall back to the plain
# name rather than trying to run the compiler itself as gcov.
GCOV ?= $(if $(findstring g++,$(CXX)),$(subst g++,gcov,$(CXX)),gcov)
else
GCOV ?= llvm-cov gcov
endif

ifdef VERBOSE
CXXFLAGS += -DVERBOSE
endif

SUNDIALS_DIR ?= /usr/local

SUNDIALS_INC ?=$(realpath $(SUNDIALS_DIR)/include)
SUNDIALS_LIB ?=$(realpath $(SUNDIALS_DIR)/lib)

ifeq ($(strip $(SUNDIALS_INC)),)
$(error "Sundials include directory not found at $(SUNDIALS_DIR)/include")
endif

ifeq ($(strip $(SUNDIALS_LIB)),)
SUNDIALS_LIB =$(realpath $(SUNDIALS_DIR)/lib64)

ifeq ($(strip $(SUNDIALS_LIB)),)
$(error "Sundials compiled library directory not found at $(SUNDIALS_DIR)/lib or $(SUNDIALS_DIR)/lib64")
endif
endif

SUNFLAGS:=$(call sysinclude,$(SUNDIALS_INC))
SUN_LINK_FLAGS = -L$(SUNDIALS_LIB) -Wl,-rpath $(SUNDIALS_LIB) -lsundials_core -lsundials_ida -lsundials_kinsol -lsundials_nvecserial

TOML11_DIR ?= ./extern/toml11/include
TOML_FLAGS := $(call sysinclude,$(realpath $(TOML11_DIR)))

CXXFLAGS += $(TOML_FLAGS) $(SUNFLAGS)

ifdef BOOST_DIR
	BOOST_FLAGS := $(call sysinclude,$(realpath $(BOOST_DIR)))
	CXXFLAGS += $(BOOST_FLAGS)
endif

# ------------------------------------------------------------------- netCDF --
#
# NETCDF_DIR / NETCDF_CXX_DIR are only needed for an install outside the
# compiler's default search path. A package-manager install -- apt's
# libnetcdf-dev + libnetcdf-c++4-dev, dnf's netcdf-devel -- lands in /usr, which
# every compiler already searches, so it needs neither; pkg-config finds it below.
#
# An explicitly-set NETCDF_DIR still wins over pkg-config. Cray's cray-netcdf
# module exports one into the environment, which ifdef picks up, and
# Makefile.local.perlmutter relies on that.
NETCDF_FLAGS :=
NETCDF_LINK_FLAGS :=

# The C++ binding's library file, which NETCDF_CXX_LIB renames for the installs
# that call it something other than netcdf_c++4. libdir_for has to look for the
# name actually on disk, or a NETCDF_CXX_DIR paired with a renamed library finds no
# directory and emits no -L.
NETCDF_CXX_LIBFILE := lib$(if $(NETCDF_CXX_LIB),$(NETCDF_CXX_LIB),netcdf_c++4)

ifdef NETCDF_DIR
	NETCDF_PREFIX := $(realpath $(NETCDF_DIR))
ifeq ($(strip $(NETCDF_PREFIX)),)
$(error netCDF directory not found at $(NETCDF_DIR), from NETCDF_DIR)
endif
	NETCDF_FLAGS += $(call sysinclude,$(NETCDF_PREFIX)/include)
	NETCDF_LINK_FLAGS += $(call syslibdir,$(call libdir_for,$(NETCDF_PREFIX),libnetcdf))
ifndef NETCDF_CXX_DIR
	NETCDF_CXX_DIR = $(NETCDF_DIR)
endif
endif

ifdef NETCDF_CXX_DIR
	NETCDF_CXX_PREFIX := $(realpath $(NETCDF_CXX_DIR))
ifeq ($(strip $(NETCDF_CXX_PREFIX)),)
$(error netCDF C++ directory not found at $(NETCDF_CXX_DIR), from NETCDF_CXX_DIR)
endif
# Only when it really is a second prefix. NETCDF_CXX_DIR defaults to NETCDF_DIR,
# and emitting the same -isystem, -L and rpath twice is how every netCDF flag
# came out doubled on the compile line before.
ifneq ($(NETCDF_CXX_PREFIX),$(NETCDF_PREFIX))
	NETCDF_FLAGS += $(call sysinclude,$(NETCDF_CXX_PREFIX)/include)
	NETCDF_LINK_FLAGS += $(call syslibdir,$(call libdir_for,$(NETCDF_CXX_PREFIX),$(NETCDF_CXX_LIBFILE)))
endif
endif

# Nobody named a prefix: ask pkg-config, which knows the multiarch libdir and
# reports -lnetcdf_c++4 ahead of -lnetcdf -- the order static linking needs, which
# the hardcoded fallback below has backwards and only shared linking forgives.
# Skipped when NETCDF_CXX_LIB is set, since that is a deliberate override of the
# library name and pkg-config would report the stock one.
ifndef NETCDF_DIR
ifndef NETCDF_CXX_DIR
ifndef NETCDF_CXX_LIB
	NETCDF_PC := $(shell pkg-config --exists netcdf netcdf-cxx4 2>/dev/null && echo yes)
endif
endif
endif

ifeq ($(NETCDF_PC),yes)
# pkg-config reports -I; these are third-party headers, so they go in as -isystem
# to stay clear of -Werror, and each still has to be filtered in case it names a
# directory the compiler already searches.
	NETCDF_FLAGS += $(foreach d,$(patsubst -I%,%,$(shell pkg-config --cflags-only-I netcdf netcdf-cxx4)),$(call sysinclude,$(d)))
	NETCDF_FLAGS += $(shell pkg-config --cflags-only-other netcdf netcdf-cxx4)
# pkg-config never reports an rpath, so a netCDF outside the loader's default path
# would link and then fail to run. Add one per -L it does report.
	NETCDF_LINK_FLAGS += $(foreach d,$(patsubst -L%,%,$(shell pkg-config --libs-only-L netcdf netcdf-cxx4)),$(call syslibdir,$(d)))
	NETCDF_LINK_FLAGS += $(shell pkg-config --libs-only-l netcdf netcdf-cxx4)
else ifndef NETCDF_CXX_LIB
	NETCDF_LINK_FLAGS += -lnetcdf -lnetcdf_c++4
else
	NETCDF_LINK_FLAGS += -lnetcdf -l$(NETCDF_CXX_LIB)
endif

CXXFLAGS += $(NETCDF_FLAGS)

ifdef EIGEN_DIR
	EIGENFLAGS = $(call sysinclude,$(EIGEN_DIR))
	CXXFLAGS += $(EIGENFLAGS)
else
	EIGENFLAGS =
endif

EIG_FLAGS = -DEIGEN_USE_BLAS 
EIG_LINK_FLAGS= -lblas -Wl,--no-as-needed -lpthread -lm -ldl

AUTODIFF_DIR ?= ./extern/autodiff/

AUTODIFF_INC = $(realpath $(AUTODIFF_DIR))

AUTODIFF_FLAGS := $(call sysinclude,$(AUTODIFF_INC))

CXXFLAGS += $(EIG_FLAGS) $(AUTODIFF_FLAGS)

LDFLAGS += $(SUN_LINK_FLAGS) $(NETCDF_LINK_FLAGS) $(EIG_LINK_FLAGS)

# The sources themselves are PYTHON_SOURCES, in the top-level Makefile, where
# the objects built from them are also needed. There used to be a PYTHON_OBJECTS
# here holding the same two *source* names, which the one-step compile-and-link
# rule listed as a prerequisite alongside the very same files spelled out; it
# named no objects and had no effect beyond the duplicate.
PYTHON_HEADERS=PyTransportSystem.hpp PyAdjointProblem.hpp PyGrid.hpp PyRunner.hpp PyIntegrator.hpp PyState.hpp
ifdef XLA_FFI
	JAX_DIR = $(shell python -c 'import jaxlib; import os; print( os.path.dirname(jaxlib.__file__) )')
	JAX_XLA_INCLUDES=-I$(JAX_DIR)/include
ifdef CUDA
	PYTHON_FLAGS=-DCUDA
else
	PYTHONFLAGS=
endif
	PYTHON_FLAGS+=-DXLA_FFI -Wno-attributes -Wno-return-type -Wno-unused-but-set-variable -Wno-changes-meaning -Wno-sign-compare
	PYTHON_HEADERS+=ffi.hpp
	
else
	JAX_XLA_INCLUDES=
	PYTHON_FLAGS=
endif

Makefile.local:
	$(error You need to provide a Makefile.local for your machine. Try copying Makefile.local.example)


